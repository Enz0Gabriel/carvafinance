# Environment variables for CarvaFinance (copy to .env)

# Database (PostgreSQL from docker-compose)
DATABASE_URL="postgresql://carva:carva@localhost:5432/carvafinance?schema=public"
# Used only by integration tests
TEST_DATABASE_URL="postgresql://carva:carva@localhost:5432/carvafinance_test?schema=public"

# Authentication (Better Auth) — generate with: npx @better-auth/cli secret
BETTER_AUTH_SECRET="change-me-to-a-random-string-with-32-plus-chars"
BETTER_AUTH_URL="http://localhost:3000"
