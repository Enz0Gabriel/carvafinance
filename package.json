{
  "name": "carvafinance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "cross-env TZ=America/Sao_Paulo vitest run",
    "test:integration": "cross-env TZ=America/Sao_Paulo vitest run --project integration",
