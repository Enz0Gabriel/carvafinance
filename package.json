    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.1",
    "msw": "^3.0.6",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
